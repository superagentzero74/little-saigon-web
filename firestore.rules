rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /businesses/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if isAdmin();
      }

      match /menuSections/{sectionId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /reviews/{id} {
      allow read: if true;
      // Doc ID must be {businessId}_{userId} — enforces one review per user per business
      allow create: if request.auth != null &&
        id == (request.resource.data.businessId + "_" + request.auth.uid);
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /users/{userId} {
      // Public profile data is readable by any signed-in user (needed for
      // Public Profile, share pages, follower lists, LS Feed avatars, etc.).
      allow read: if request.auth != null;

      allow create, delete: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Owner / admin can change anything. Other signed-in users may only
      // increment the follower/following counters (used by toggleFollow).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followerCount', 'followingCount'])
      );
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      // Doc id format: {followerId}_{followeeId} — only the follower can create/delete.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.followerId &&
        followId == (request.resource.data.followerId + "_" + request.resource.data.followeeId);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.followerId;
      allow update: if false;
    }

    match /picks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /foods/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /checkIns/{id} {
      allow read, write: if request.auth != null;
    }

    match /checkins/{id} {
      allow read, write: if request.auth != null;
    }

    match /pointsLog/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /redemptions/{id} {
      allow read, write: if request.auth != null;
    }

    match /dishFeatured/{dishRank} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promoBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /claimRequests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin();
    }

    // Rewards & Promotions
    match /rewards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userOffers/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Challenges
    match /challenges/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /submissions/{subId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if isAdmin();
      }
    }

    // Analytics — sessions
    match /sessions/{sessionId} {
      allow create, update, delete: if true;
      allow read: if request.auth != null;
    }

    // Analytics — event log
    match /eventLog/{eventId} {
      allow read, create: if true;
    }

    // Login attempts — fire-and-forget telemetry. Anyone (auth or not) can
    // create so failed attempts before sign-in are still captured. Admin-only
    // read for the dashboard.
    match /loginAttempts/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Search queries — fire-and-forget telemetry of user search activity.
    // Lets the admin dashboard surface top queries + zero-result queries.
    match /searchQueries/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Analytics — daily stats (written by Cloud Functions only)
    match /stats/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions write
    }

    // Dish Votes (Mon Viet Guide)
    match /dishVotes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Game Rooms
    match /gameRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      // Hands, rounds, and ledger entries written during the round
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Support tickets
    match /support_tickets/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Feedback / suggestions (Submit form)
    match /feedback/{id} {
      allow create: if true;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Business suggestions (Suggest a Business form)
    match /businessSuggestions/{id} {
      allow create: if true;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Reports
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Recipes
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers — admin CRM for restaurant owners / business clients.
    // Admin-only read/write. Create enforces the uid + shape contract so
    // bad clients can't write garbage that breaks list/detail queries.
    match /customers/{customerId} {
      function validCustomer(d) {
        return d.uid is string
          && d.contactPerson is map
          && d.contactPerson.name is string && d.contactPerson.name.size() > 0
          && d.contactPerson.email is string
          && d.contactPerson.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && d.contactPerson.phone is string
          && d.contactPerson.title is string
          && d.businessIds is list
          && d.status in ['active', 'inactive', 'churned']
          && d.interests is list
          && d.servicesInterested is list;
      }
      allow read:   if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && validCustomer(request.resource.data);
      allow update: if isAdmin() && validCustomer(request.resource.data);
      allow delete: if isAdmin();
    }

    // CollectionGroup: photos (needed for admin photo feed query)
    match /{path=**}/photos/{photoId} {
      allow read: if true;
    }

    // ── Community Forum ───────────────────────────────────────
    match /forumCategories/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forumThreads/{threadId} {
      allow read: if true;
      // Author must own the doc on create
      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid;
      // Owner can edit body/title only. Counters/lastReply updated by anyone
      // signed in (reply path needs to bump them) or admin.
      allow update: if request.auth != null &&
        (resource.data.authorId == request.auth.uid || isAdmin() ||
         // Counter-only update: replyCount/lastReplyAt/lastReplyBy/upvoteCount changes
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['replyCount', 'lastReplyAt', 'lastReplyBy', 'upvoteCount']));
      allow delete: if isAdmin() ||
        (request.auth != null && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null &&
          (resource.data.authorId == request.auth.uid || isAdmin() ||
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['upvoteCount']));
        allow delete: if isAdmin() ||
          (request.auth != null && resource.data.authorId == request.auth.uid);

        match /upvotes/{userId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /upvotes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /forumReports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
